{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Cafeteria: iniciar servidor",
            "type": "process",
            "command": "node",
            "args": ["server.js"],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "isBackground": true,
            "problemMatcher": {
                "pattern": [
                    {
                        "regexp": ".*"
                    }
                ],
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": ".*Serving HTTP on.*",
                    "endsPattern": ".*"
                }
            }
        }
    ]
}